{
  "manifestVersion": 5,
  "id": "com.jocsankleyver.colorlab.premiere.prototype",
  "name": "Color Lab",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "colorLabPrototypePanel",
      "label": {
        "default": "Color Lab"
      },
      "description": {
        "default": "Color Lab para Premiere: Looks, Intensity, Split Tone, Bloom, Halation y Film Grain sobre el clip seleccionado."
      },
      "minimumSize": {
        "width": 320,
        "height": 600
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 780
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 780
      }
    }
  ]
}

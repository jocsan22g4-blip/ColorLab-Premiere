{
  "manifestVersion": 5,
  "id": "com.jocsankleyver.colorlab.premiere.prototype",
  "name": "Color Lab (prototipo)",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "colorLabPrototypePanel",
      "label": {
        "default": "Color Lab (prototipo)"
      },
      "description": {
        "default": "Prototipo minimo: aplica el efecto Color Lab al clip seleccionado y controla Look e Intensity. Sin identidad visual final."
      },
      "minimumSize": {
        "width": 280,
        "height": 340
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 480
      }
    }
  ]
}

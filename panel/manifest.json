{
  "manifestVersion": 5,
  "id": "com.jocsankleyver.colorlab.premiere.prototype",
  "name": "Color Lab",
  "version": "0.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "colorLabPrototypePanel",
      "label": {
        "default": "Color Lab"
      },
      "description": {
        "default": "Navegador de Looks con miniaturas y control de Intensity; aplica Color Lab al clip seleccionado. Sin identidad visual final ni perfiles de camara."
      },
      "minimumSize": {
        "width": 280,
        "height": 340
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 480
      }
    }
  ]
}
